APP_NAME="Consulta Hoy Perú"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Lima
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Desarrollo local: SQLite
DB_CONNECTION=sqlite
# Producción (Coolify): PostgreSQL 16
# DB_CONNECTION=pgsql
# DB_HOST=postgres
# DB_PORT=5432
# DB_DATABASE=consultahoy
# DB_USERNAME=consultahoy
# DB_PASSWORD=

# Sesión, colas y caché en desarrollo local
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=sync
CACHE_STORE=file
# Producción (Coolify): Redis
# SESSION_DRIVER=redis
# QUEUE_CONNECTION=redis
# CACHE_STORE=redis
# REDIS_HOST=redis
# REDIS_PASSWORD=null
# REDIS_PORT=6379

FILESYSTEM_DISK=local

# CORS (dominios web de Astro / frontends permitidos)
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:4321"

# Rate Limiting general por IP (por minuto)
RATE_LIMIT_GENERAL=60

# Módulo Dólar y Monedas
DOLAR_DRIVER=open_er_api

# Módulo Sismos
SISMOS_DRIVER=usgs

# Módulo Feriados
FERIADOS_DRIVER=nager

# Módulo RUC
RUC_DRIVERS=peru_consult,padron_sunat
PERU_CONSULT_URL=http://localhost:8080
PERU_CONSULT_TOKEN=
RATE_LIMIT_RUC=20

# Versionado y Documentación OpenAPI
API_VERSION=1.0.0
